# BFF(Worker) のベース URL。
# ローカル: wrangler dev の既定 http://localhost:8787
# 本番: 同一 registrable domain の Worker（例 https://api.example.com）
VITE_API_BASE=http://localhost:8787

# バス時刻 API（kajiLabTeam/ait-bus-v2 の /api/v2/afterbus）のオリジン。未設定時は https://bus.kajilab.net
# VITE_BUS_API_BASE=https://bus.kajilab.net
