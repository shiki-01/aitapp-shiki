{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aitapp-desktop",
  "version": "1.0.0",
  "identifier": "com.aitapp.desktop",
  "build": {
    "beforeBuildCommand": "cd ../../web && bun run build:desktop",
    "frontendDist": "../../web/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "愛工大ポータル",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
